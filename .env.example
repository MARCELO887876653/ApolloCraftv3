# ApolloCraft Security - Environment Configuration
# Destination: GitHub -> Vercel (https://apollocraft.online) + Supabase

# Supabase Public Configuration (Safe for client-side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Application URLs
NEXT_PUBLIC_APP_URL=https://apollocraft.online
APP_URL=https://apollocraft.online

# Minecraft Bedrock API Authentication (SERVER-SIDE ONLY)
# Master key/secret used to bootstrap or sign administrative server communications
MINECRAFT_API_MASTER_KEY=your_minecraft_master_api_key_32_chars_min
MINECRAFT_HMAC_MASTER_SECRET=your_minecraft_hmac_master_secret_64_chars_hex

# Anti-VPN / Proxy / Tor Detection Provider (SERVER-SIDE ONLY)
# Supported providers: "disabled", "proxycheck", "ipinfo"
IP_RISK_PROVIDER=disabled
IP_RISK_API_KEY=

# Discord Webhook for Security Alerts (SERVER-SIDE ONLY)
DISCORD_WEBHOOK_URL=

# Cron Secret for Vercel Cron Maintenance Jobs (SERVER-SIDE ONLY)
CRON_SECRET=your_cron_secret_random_uuid
